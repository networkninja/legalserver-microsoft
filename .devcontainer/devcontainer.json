{
  "name": "legalserver-sharepoint-operator-environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-vscode.powershell"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install .",
  "postStartCommand": "az version",
  "overrideCommand": true
}
